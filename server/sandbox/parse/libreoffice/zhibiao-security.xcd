<?xml version="1.0" encoding="UTF-8"?>
<!--
  parse 沙箱中 LibreOffice 的全局安全设置（路线图第 6 步 6.6，#28 确认时决定与解析入口同时上线）。
  放在 share/registry 下随安装加载，各项 finalized：用户配置（每次解析新建在 /tmp 的临时配置）不能覆盖。
  - 不执行宏：宏安全级别“非常高”（只允许受信任位置，未设置任何受信任位置），并禁用宏执行；
  - 链接更新设为从不：Writer、Calc 的链接（含外部文件、OLE、DDE 链接）不更新，Writer 的域和图表不在加载时更新；
  - 阻止从不受信任的引用加载外部资源（远程图片等）。
  沙箱完全断网是兜底，不是唯一措施（路线图第 6 步“按记录的 MIME 分派”）。
-->
<oor:data xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:oor="http://openoffice.org/2001/registry">
  <dependency file="main"/>
  <oor:component-data oor:package="org.openoffice.Office" oor:name="Common">
    <node oor:name="Security">
      <node oor:name="Scripting">
        <prop oor:name="MacroSecurityLevel" oor:finalized="true"><value>3</value></prop>
        <prop oor:name="DisableMacrosExecution" oor:finalized="true"><value>true</value></prop>
        <prop oor:name="BlockUntrustedRefererLinks" oor:finalized="true"><value>true</value></prop>
      </node>
    </node>
  </oor:component-data>
  <oor:component-data oor:package="org.openoffice.Office" oor:name="Writer">
    <node oor:name="Content">
      <node oor:name="Update">
        <prop oor:name="Link" oor:finalized="true"><value>2</value></prop>
        <prop oor:name="Field" oor:finalized="true"><value>false</value></prop>
        <prop oor:name="Chart" oor:finalized="true"><value>false</value></prop>
      </node>
    </node>
  </oor:component-data>
  <oor:component-data oor:package="org.openoffice.Office" oor:name="Calc">
    <node oor:name="Content">
      <node oor:name="Update">
        <prop oor:name="Link" oor:finalized="true"><value>2</value></prop>
      </node>
    </node>
  </oor:component-data>
</oor:data>
