{
  "name": "bidtools-server",
  "version": "0.1.0",
  "private": true,
  "description": "Web 版服务端（docs/SERVER_DESIGN.md）",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "dev": "node --watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.ts",
    "db:migrate": "node src/db/migrate.ts latest",
    "db:rollback": "node src/db/migrate.ts down",
    "admin:create": "node src/cli/create-admin.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1145.0",
    "@aws-sdk/lib-storage": "3.1145.0",
    "@fastify/helmet": "13.1.1",
    "fastify": "5.12.5",
    "kysely": "0.29.6",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
